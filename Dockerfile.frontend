# Build stage
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first (cached while package files do not change)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Build the app. The page calls /api and /ws on its own origin; nginx forwards them to the
# backend (nginx.conf), so no API address is baked into the build. Set VITE_API_URL only if
# the backend is on another host.
COPY frontend/ .
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Production stage
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
