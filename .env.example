# --- Local language model (Ollama) ---
# Install Ollama (https://ollama.com), then: ollama pull gemma3:4b
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=gemma3:4b
# LLM_TEMPERATURE=0.8
# LLM_MAX_TOKENS=256
# LLM_NUM_CTX=4096
# LLM_KEEP_ALIVE=30m
# LLM_TIMEOUT=120

# --- Game (optional) ---
# DEFAULT_PLAYERS=8
# MIN_PLAYERS=4
# MAX_PLAYERS=12
# DISCUSSION_MAX_ROUNDS=5
# MEMORY_MESSAGES=4
# DISCUSSION_CONTEXT_MESSAGES=10

# Show every player's role in the API (debug / spectator). Default: roles of living players are hidden
# REVEAL_ROLES=false

# --- Server (optional) ---
# MAX_SESSIONS=20
# SESSION_TTL_MINUTES=120
# LOG_LEVEL=INFO
# HOST=0.0.0.0
# PORT=8000
# JSON list of allowed frontend origins
# CORS_ORIGINS=["http://localhost:3000"]
