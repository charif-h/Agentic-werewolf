# --- AI providers (set the key of the provider you use) ---
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Preferred AI provider: openai, gemini or mistral
AI_PROVIDER=openai

# Optional model overrides
# OPENAI_MODEL=gpt-4
# GEMINI_MODEL=gemini-2.5-pro
# MISTRAL_MODEL=mistral-small-latest
# PLAYER_TEMPERATURE=0.8

# --- Game (optional) ---
# DEFAULT_PLAYERS=8
# MIN_PLAYERS=4
# MAX_PLAYERS=12
# DISCUSSION_MAX_ROUNDS=5
# MEMORY_MESSAGES=4
# DISCUSSION_CONTEXT_MESSAGES=10
# Pauses between LLM calls, in seconds (cloud rate limits)
# DISCUSSION_DELAY=0.3
# ROUND_DELAY=0.5
# VOTE_DELAY=0.5
# RATE_LIMIT_DELAY=1.0

# Show every player's role in the API (debug / spectator). Default: roles of living players are hidden
# REVEAL_ROLES=false

# --- Server (optional) ---
# HOST=0.0.0.0
# PORT=8000
# JSON list of allowed frontend origins
# CORS_ORIGINS=["http://localhost:3000"]
